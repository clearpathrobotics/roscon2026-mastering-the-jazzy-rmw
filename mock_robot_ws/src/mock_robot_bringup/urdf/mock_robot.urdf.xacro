<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mock_robot">
  <xacro:arg name="robot_name" default="mock_robot"/>
  <xacro:arg name="tf_prefix" default="robot"/>
  <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>

  <link name="world"/>
  <link name="${tf_prefix}/odom"/>
  <link name="${tf_prefix}/base_link"/>
  <link name="${tf_prefix}/front_left_wheel_link"/>
  <link name="${tf_prefix}/front_right_wheel_link"/>
  <link name="${tf_prefix}/rear_left_wheel_link"/>
  <link name="${tf_prefix}/rear_right_wheel_link"/>

  <joint name="world_to_odom_joint" type="fixed">
    <parent link="world"/>
    <child link="${tf_prefix}/odom"/>
  </joint>

  <joint name="odom_to_base_joint" type="fixed">
    <parent link="${tf_prefix}/odom"/>
    <child link="${tf_prefix}/base_link"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="${tf_prefix}/base_link"/>
    <child link="${tf_prefix}/front_left_wheel_link"/>
    <origin xyz="0.15 0.15 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="${tf_prefix}/base_link"/>
    <child link="${tf_prefix}/front_right_wheel_link"/>
    <origin xyz="0.15 -0.15 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="${tf_prefix}/base_link"/>
    <child link="${tf_prefix}/rear_left_wheel_link"/>
    <origin xyz="-0.15 0.15 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="${tf_prefix}/base_link"/>
    <child link="${tf_prefix}/rear_right_wheel_link"/>
    <origin xyz="-0.15 -0.15 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="$(arg robot_name)_hardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
