#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2034,SC2317
# workshop - single host-side entrypoint for the RMW workshop lab harness.

# Run it, don't source it: `set -euo pipefail` below would otherwise leak into
# an interactive shell and could kill it on a later, unrelated command.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    echo "workshop: run it, don't source it - use 'scripts/workshop ...'" >&2
    return 1 2>/dev/null || exit 1
fi

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOCKER_ROOT="$REPO_ROOT/docker"
COMPOSE_DIR="$DOCKER_ROOT/compose"

# shellcheck source=../docker/scripts/lib.sh
. "$DOCKER_ROOT/scripts/lib.sh"
# shellcheck source=lib/workshop_core.sh
. "$SCRIPT_DIR/lib/workshop_core.sh"

cmd_up() {
    local arg n="" rmw="" skip_gen="" partial_gen=""
    # Generic bring-up: N and rmw may appear in either order.
    # Empty n lets topo_up apply the per-topology default (routed=15, not 3).
    for arg in "$@"; do
        case "$arg" in
            [0-9]*) n="$arg" ;;
            cyclone|cyclonedds|fast|fastdds|fastrtps|zenoh) rmw="$arg" ;;
            --skip-gen) skip_gen=1 ;;
            --partial-gen) partial_gen=1 ;;
            --webshark|--drive) fail "'up' no longer takes --webshark/--drive; bring the fleet up with 'scripts/workshop -t flat up N [rmw]', then 'scripts/workshop webshark up'"; return 2 ;;
            *) fail "unknown up option: $arg"; return 2 ;;
        esac
    done
    if [[ -n "$skip_gen" && -n "$partial_gen" ]]; then
        fail "--skip-gen and --partial-gen are mutually exclusive (--skip-gen reuses existing output; --partial-gen regenerates it with placeholders)"; return 2
    fi
    [[ -n "$partial_gen" ]] && export PARTIAL_GEN=1
    topo_up "$topo" "$n" "$rmw" "$skip_gen"
}

usage() {
    cat <<'EOF'
workshop - RMW workshop entrypoint

Usage: workshop [-t star|flat|routed] [--build] [--model a300|r100|j100] <up|down> [N] [rmw]

  up [N] [rmw]   Generate + bring up the topology stack
                 (default topology star; N default star=3 flat=3 routed=15, max 25)
                 --skip-gen reuses the already-generated compose file and
                 rmw_configurations as-is (edit them by hand, then bring the stack up)
                 --partial-gen regenerates the rmw_configurations with editable address
                 placeholders (MOCK_ROBOT_<k>_IP, OBSERVER_IP, OBSERVER_IP_BR<k>) instead
                 of real IPs (mutually exclusive with --skip-gen)
  down [--all]   Tear the fleet down; --all also stops webshark/netdata/collector/lichtblick/lab4-core
  webshark <up|down>  Bring the webshark capture viewer up/down (independent of any fleet)
  netdata <up|down>   Bring Netdata up/down (independent of any fleet)
  observer bridge  Start the idle observer's Foxglove bridge (any topology)
  observer capture start [N] [--streaming] [--duration S] [--files N] [--autostop S] [--max-mb MB]
                 Start a rotating (default) or streaming capture at the observer
  observer capture <stop|bounce>  Stop/finalize a capture, or retrigger discovery traffic
  observer capture clear  Delete this harness's captured pcaps from captures/ (manual, confirms first)
  lichtblick <up|down>  Bring the Lichtblick web UI container up/down (orthogonal to topologies)
  shell <name>   Open an interactive shell in a running container (e.g. mock-robot-1, observer)
  collector up   Start the fleet-targeted Netdata collector
  collector down Stop the fleet-targeted Netdata collector
  netem [profile|clear|list] [robot] [--rate RATE]  Apply/clear/list shaping, or show
                 the current shaping state when run bare (flat; routed also supports rateonly)
  preflight      Check common host capabilities and selected topology prerequisites
  run [opts]     Run the Lab 4 benchmark sweep (Template A/B -> reports)
  gen-bag [name] [secs]
                 Generate a synthetic Lab 4 benchmark bag
  fetch-bag [name] [tag]
                 Fetch a published Lab 4 benchmark bag
  help           Show this help

Options: --build (build the ROS workspace in-container - editable source, works before the
         image is built); --half-scan (halve the synthesized LiDAR FOV to 180°, HALF_SCAN=1);
         --model MODEL[,MODEL...] (per-robot model a300|r100|j100; a single
         value applies to every robot, a list is assigned to robot 1..N in order and cycles
         when shorter than N, extra entries ignored). --rmw-directory DIR uses a pre-built
         config directory for the selected RMW instead of generating it (flat+cyclone,
         routed+zenoh only). Also WORKSHOP_BUILD=1 / WORKSHOP_MODEL.
Topology also via -t/--topology or WORKSHOP_TOPOLOGY; RMW via 3rd arg or WORKSHOP_RMW.
EOF
}

main() {
    local topo="${WORKSHOP_TOPOLOGY:-star}" topo_set="" args=()
    [[ "${WORKSHOP_BUILD:-}" =~ ^(1|true)$ ]] && export MOCK_BUILD=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--topology) topo="${2:?-t/--topology needs a value}"; topo_set=1; shift 2 ;;
            --build) export MOCK_BUILD=true; shift ;;
            --half-scan) export HALF_SCAN=1; shift ;;
            --model) WORKSHOP_MODEL="${2:?--model needs a value}"; shift 2 ;;
            --rmw-directory) export RMW_OVERRIDE_DIR="${2:?--rmw-directory needs a value}"; shift 2 ;;
            *) args+=("$1"); shift ;;
        esac
    done
    set -- "${args[@]:-help}"
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        up|down|collector) _check_topo "$topo" || return 2 ;;
    esac
    case "$cmd" in
        up) cmd_up "$@" ;;
        down) cmd_down "$topo" "$@" ;;
        collector) cmd_collector "$topo" "$@" ;;
        observer) cmd_observer "$@" ;;
        lichtblick) cmd_lichtblick "$@" ;;
        webshark) cmd_webshark "$@" ;;
        netdata) cmd_netdata "$@" ;;
        shell) cmd_shell "$@" ;;
        netem)
            # Bare netem (status) with no explicit -t should read the fleet that is
            # actually running, not the star default, so it reports the AP/link shaping
            # instead of "star has no shaping".
            [[ -n "$topo_set" ]] || { local rt; rt="$(running_topology)"; [[ -n "$rt" ]] && topo="$rt"; }
            cmd_netem "$topo" "$@" ;;
        preflight)
            # Bare preflight (no explicit -t) should check the fleet that is actually
            # running, not the star default, so it doesn't report a missing compose file.
            [[ -n "$topo_set" ]] || { local rt; rt="$(running_topology)"; [[ -n "$rt" ]] && topo="$rt"; }
            workshop_preflight "$topo" "$@" ;;
        run) cmd_lab4_run "$@" ;;
        gen-bag) cmd_lab4_genbag "$@" ;;
        fetch-bag) cmd_lab4_fetchbag "$@" ;;
        help|-h|--help) usage ;;
        *) fail "unknown command: $cmd"; echo; usage; return 2 ;;
    esac
}

main "$@"
