{
  // Pin Zenoh to mock-robot-2's exact mock-b0 address (172.30.10.0/24 is the
  // only segment shared with the observer and mock-robot-1). Binding the
  // multicast scouting interface and the listen endpoint to that NIC keeps
  // discovery + peer connections on the shared bridge, so the observer
  // reliably finds this robot across the star topology. Analogous to
  // cyclone/mock-robot-2.xml's <NetworkInterface>.
  mode: "peer",

  scouting: {
    multicast: {
      enabled: true,
      interface: "172.30.10.12",
      autoconnect: { router: ["peer"], peer: ["peer"] },
    },
    gossip: {
      enabled: true,
      autoconnect: { router: ["peer"], peer: ["peer"] },
    },
  },

  listen: {
    endpoints: ["tcp/172.30.10.12:0"],
  },

  transport: {
    shared_memory: {
      enabled: false,
    },
  },
}
